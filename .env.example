POSTGRES_USER=ledger
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=ledger_hq
AUTH_SALT_SECRET=generate-32-random-bytes-base64
# Where obligation attachments are stored inside the api container. The
# Compose file mounts the attachments-data volume here; change both together.
ATTACHMENTS_DIR=/var/lib/ledger-hq/attachments
BACKUP_AGE_RECIPIENT=age1...
BACKUP_LOCAL_DIR=/var/backups/ledger-hq
BACKUP_REMOTE=remote:ledger-hq

# Host ports the stack binds to on 127.0.0.1. The defaults are right for the
# primary checkout; give each extra git worktree its own values (in its own
# .env) so the stacks can run side by side.
POSTGRES_PORT=5432
WEB_PORT=8080
